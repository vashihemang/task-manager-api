# PostgreSQL database connection URL (Required)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/task_manager

# JWT signing secret key (Required: minimum 32 bytes)
JWT_SECRET_KEY=replace-with-a-secure-secret-key-at-least-32-bytes-long

# Optional teacher registration key (if set, must be at least 32 bytes and passed in X-Teacher-Registration-Key header)
TEACHER_REGISTRATION_KEY=

# Token expiration settings
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Optional PostgreSQL connection pool tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800